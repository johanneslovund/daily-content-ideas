ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret between this service and ptp-internal's /api/content-ideas-url
# endpoint. Must match the Cloudflare Pages secret of the same name (set via
# "npx wrangler pages secret put TUNNEL_UPDATE_SECRET" in ptp-internal/deploy).
TUNNEL_UPDATE_SECRET=

# Optional: override the built-in brand context for any of the three tabs.
# Sensible defaults for Kygo / Palm Tree Productions / Johannes Lovund already
# live in server.js - only set these if you want to change them.
# BRAND_CONTEXT_KYGO=
# BRAND_CONTEXT_PTP=
# BRAND_CONTEXT_JOHANNES=

# Set these in Portainer's "Environment variables" field when creating the stack.
# Do NOT commit real values to this repo.
